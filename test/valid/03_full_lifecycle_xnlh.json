      "source_of_knowledge": "research",
      "author_identity": "real_name",
      "style": "academic",
      "text": "西南联大在滇八年，于战火之中保存并延续了中国高等教育的命脉。三校合一而学统各异，其\"刚毅坚卓\"的校训与教授治校的传统，对战后中国学术格局产生了深远影响。本叙述基于校史档案与既有研究文献。",
      "language": "zh-Hans",
      "created_at": "2026-06-01T14:20:00Z",
      "endorsed_by": [
        "user:archivist_wang",
        "user:zhang_1946"
      ]
    },
